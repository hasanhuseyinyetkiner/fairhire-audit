# Native local demo. Copy to .env if you want to override defaults.
# The process binds loopback unless FAIRHIRE_ALLOW_NETWORK_BIND=true.
FAIRHIRE_APP_ENV=demo
FAIRHIRE_DATABASE_URL=sqlite:///./data/fairhire.db
FAIRHIRE_BIND_HOST=127.0.0.1
FAIRHIRE_PORT=8104
FAIRHIRE_ALLOW_NETWORK_BIND=false
FAIRHIRE_DATA_RETENTION_DAYS=30
FAIRHIRE_BOOTSTRAP_ITERATIONS=1000
FAIRHIRE_BOOTSTRAP_SEED=20261020
FAIRHIRE_SMALL_GROUP_MIN_N=30
FAIRHIRE_SEED_DEMO=true
FAIRHIRE_CORS_ORIGINS=http://127.0.0.1:5104,http://localhost:5104
